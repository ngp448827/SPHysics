<?xml version="1.0" encoding="UTF-8" ?>
<case app="GenCase v5.4.354.01 (07-04-2025)" date="15-05-2026 11:58:34">
    <casedef>


    <!-- ===CONSTANTS=== -->
        <constantsdef>
            <gravity x="0" y="0" z="-9.81"
                    units_comment="Units m/(s^2)"/>
            <rhop0 value="1000" 
                comment="Reference density of the fluid" units_comment="kg/m^3" />
            <rhopgradient value="2" 
                comment="Initial density gradient 1:Rhop0, 2:Water column, 3:Max. water height (default=2)" />
            <hswl value="0" auto="true" 
                comment="Maximum still water level to calculate speedofsound using coefsound" units_comment="metres (m)" />
            <gamma value="7" 
                comment="Polytropic constant for water used in the state equation" />
            <speedsystem value="0" auto="true" 
                comment="Maximum system speed (by default the dam-break propagation is used)" />
            <coefsound value="20" 
                comment="Coefficient to multiply speedsystem" />
            <speedsound value="0" auto="true" 
                comment="Speed of sound to use in the simulation (by default speedofsound=coefsound*speedsystem)" />
            <coefh value="1.2" 
                comment="Coefficient to calculate the smoothing length (h=coefh*sqrt(3*dp^2) in 3D)" />
            <cflnumber value="0.2" 
                comment="Coefficient to multiply dt" />
        </constantsdef>


    <!-- ===== MK CONFIG =====                    -->
    <!-- mk=10: Flap wavemaker (moving boundary)  -->
    <!-- mk=11: Tank walls/floor (fixed boundary) -->
    <!-- mk=1:  Fluid (water)                     -->

        <mkconfig boundcount="230" fluidcount="9">
            <mkorientfluid mk="1" orient="Xyz" />
        </mkconfig>

    <!-- ===== GEOMETRY: Square Prism Tank ===== -->
    <!-- Tank: 6m long, 1m wide, 1m tall         -->
    <!-- Water depth: 0.6m                       -->
    <!-- dp=0.02 gives ~30 particles per meter   -->

        <geometry>
            <definition dp="0.02">
                <pointref x="0" y="0" z="0" />
                <pointmin x="0" y="0" z="0" />
                <pointmax x="6" y="1" z="1" />
            </definition>


            <commands>
                <mainlist>
                    <setshapemode>real | dp | bound</setshapemode>
                    <setdrawmode mode="full" />

                <!-- Flap wavemaker (moving boundary, mk=10) -->
                    <setmkbound mk="10" />
                    <drawbox>
                        <boxfill>solid</boxfill>
                        <point x="0" y="0" z="0" />
                        <size x="0.02" y="1" z="0.6" />
                        <!-- thin plate at x=0 that spans full width and water depth-->
                    </drawbox>

                <!-- ================   -->
                <!-- Tank bounds (fixed boundary, mk=11) -->
                    <setmkbound mk="11" />
                    
                    <!-- Floor -->
                    <drawbox>
                        <boxfill>solid</boxfill>
                        <point x="0" y="0" z="0" />
                        <size x="6" y="1" z="0.02" />
                    </drawbox>

                    <!-- Back wall -->
                    <drawbox>
                        <boxfill>solid</boxfill>
                        <point x="5.98" y="0" z="0" />
                        <size x="0.02" y="1" z="1" />
                    </drawbox>

                    <!-- side wall 1 (y=0) -->
                    <drawbox>
                        <boxfill>solid</boxfill>
                        <point x="0" y="0" z="0" />
                        <size x="6" y="0.02" z="1" />
                    </drawbox> 

                    <!-- side wall 2 (y=1) -->
                    <drawbox>
                        <boxfill>solid</boxfill>
                        <point x="0" y="0.98" z="0" />
                        <size x="6" y="0.02" z="1" />
                    </drawbox>
                <!-- ================   -->
                <!-- Water (fluid, mk=1) -->    
                    <setmkfluid mk="1" />
                    <fillbox x="3" y="0.5" z="0.3" >
                        <modefill>fluid</modefill>
                        <point x="0.02" y="0.02" z="0.02" />
                        <size x="5.96" y="0.96" z="0.6" />
                    </fillbox>

                    <shapeout file="" reset="true" />
                </mainlist>
            </commands>
        </geometry>



        <!-- Removed this section because it conflicts with the wavepaddles motion 
             defined in the execution section. 
             The flap motion is now handled by the wavepaddles special feature.
        <motion>
            <objreal ref="10">
                <begin mov="1" start="0" />
                <mvnull id="1" />
            </objreal>
        </motion>
                -->
    </casedef>

    <!-- ===EXECUTION=== -->

    <execution>

        <special>
            <wavepaddles>
                <flap>
                    <mkbound value="10" 
                        comment="Mk-Bound of selected particles" />
                    <waveorder value="2" 
                        comment="Order wave generation 1:1st order, 2:2nd order (def=1)" />
                    <start value="0" 
                        comment="Start time (default=0)" />
                    <duration value="0" 
                        comment="Movement duration, Zero is the end of simulation (default=0)" />

                    <!-- sets hing at bottom (z=0) -->
                    <depth value="0.6" 
                        comment="Water depth (default=0)" />
                    <variabledraft value="0.0" 
                        comment="Position of the wavemaker hinge (above the bottom <0; below the bottom >0) (default=0)" />
                    
                    <!-- rotation of hinge along Y -->
                    <flapaxis0 x="0" y="0" z="0.0" 
                        comment="chnged from -1 to 0 so it stays within domain of the sim" />
                    <flapaxis1 x="0" y="1" z="0.0" 
                        comment="Point 1 of axis rotation" />

                    <!-- Wave parameters -->
                    <waveheight value="0.15" 
                        comment="Wave height" />
                    <waveperiod value="2" 
                        comment="Wave period" />
                    <phase value="0" 
                        comment="Initial wave phase in function of PI (default=0)" />
                    <ramp value="1" 
                        comment="Periods of ramp (default=0)" />

                    <!-- monitor point at mid-tank depth -->
                    <savemotion periods="20" periodsteps="20" xpos="3.0" zpos="-0.3" 
                        comment="Saves motion data. xpos and zpos are optional. zpos=-depth of the measuring point" />
                </flap>
            </wavepaddles>
        </special>



        <parameters>

            <!-- output -->
            <parameter key="SavePosDouble" value="0" 
                comment="Saves particle position using double precision (default=0)" />

            <!-- time integration -->
            <parameter key="StepAlgorithm" value="2" 
                comment="Step Algorithm 1:Verlet, 2:Symplectic (default=1)" />
            <parameter key="VerletSteps" value="40" 
                comment="Verlet only: Number of steps to apply Euler timestepping (default=40)" /> 

            <!-- SPH settings -->
            <parameter key="Kernel" value="2" 
                comment="Interaction Kernel 1:Cubic Spline, 2:Wendland (default=2)" />
            <parameter key="ViscoTreatment" value="1" 
                comment="Viscosity formulation 1:Artificial, 2:Laminar+SPS, 3:Laminar (default=1)" />
            <parameter key="Visco" value="0.01" 
                comment="Viscosity value. Typically 0.01 for Artificial and 1e-6 m^2/s (water kinematic viscosity) for Laminar" />
            <parameter key="ViscoBoundFactor" value="1" 
                comment="Multiply viscosity value with boundary (default=1)" />

            <!-- Density -->
            <parameter key="DensityDT" value="2" 
                comment="Density Diffusion Term 0:None, 1:Molteni, 2:Fourtakas, 3:Fourtakas(full) (default=0)" />
            <parameter key="DensityDTvalue" value="0.1" 
                comment="DDT value (default=0.1)" /> 

            <!-- Shifting --> 
            <parameter key="Shifting" value="0" 
                comment="Shifting mode 0:None, 1:Ignore bound, 2:Ignore fixed, 3:Full (default=0)" />
            <parameter key="ShiftCoef" value="-2" 
                comment="Coefficient for shifting computation (default=-2)" />
            <parameter key="ShiftTFS" value="0" 
                comment="Threshold to detect free surface. Typically 1.5 for 2D and 2.75 for 3D (default=0)" />
            <parameter key="RigidAlgorithm" value="1" 
                comment="Rigid Algorithm 0:collision-free, 1:SPH, 2:DEM, 3:Chrono (default=1)" />
            <parameter key="FtPause" value="0.0" 
                comment="Time to freeze the floatings at simulation start (warmup) (default=0)" units_comment="seconds" />

            <!-- Time step -->
            <parameter key="CoefDtMin" value="0.05" 
                comment="Coefficient to calculate minimum time step dtmin=coefdtmin*h/speedsound (default=0.05)" />
            <parameter key="DtIni" value="0" 
                comment="Initial time step. Use 0 to default use (default=h/speedsound)" units_comment="seconds" />
            <parameter key="DtMin" value="0" 
                comment="Minimum time step. Use 0 to default use (default=coefdtmin*h/speedsound)" units_comment="seconds" />
            <parameter key="DtFixed" value="0" 
                comment="Fixed Dt value. Use 0 to disable (default=disabled)" units_comment="seconds" />
            <parameter key="DtFixedFile" value="NONE" 
                comment="Dt values are loaded from file. Use NONE to disable (default=disabled)" units_comment="milliseconds (ms)" />
            <parameter key="DtAllParticles" value="0" 
                comment="Velocity of particles used to calculate DT. 1:All, 0:Only fluid/floating (default=0)" />

            <!-- Simulation time -->
            <parameter key="TimeMax" value="30" 
                comment="Time of simulation" units_comment="seconds" />
            <parameter key="TimeOut" value="0.05" 
                comment="Time out data" units_comment="seconds" /> 

            <parameter key="PartsOutMax" value="1" 
                comment="**DEPRECATED** %/100 of fluid particles allowed to be excluded from domain (default=1)" units_comment="decimal" />
            
            <!-- density limits -->
            <parameter key="RhopOutMin" value="700" 
                comment="Minimum rhop valid (default=700)" units_comment="kg/m^3" />
            <parameter key="RhopOutMax" value="1300" 
                comment="Maximum rhop valid (default=1300)" units_comment="kg/m^3" />

            <!-- Simulation domain --> 
            <simulationdomain comment="Defines domain of simulation (default=Uses minimum and maximum position of the generated particles)">
                <posmin x="default" y="default" z="default" comment="e.g.: x=0.5, y=default-1, z=default-10%" />
                <posmax x="default" y="default" z="default + 10%" />
            </simulationdomain>

        </parameters>

        <particles np="8896" nb="8896" nbf="7800" mkboundfirst="10" mkfluidfirst="1">
            <_summary>
                <positions units_comment="metres (m)">
                    <posmin x="0" y="0" z="0" />
                    <posmax x="5.98" y="0.98" z="0.1" />
                </positions>
                <fixed count="7800" id="0-7799" mkcount="1" mkvalues="10" />
                <moving count="1096" id="7800-8895" mkcount="1" mkvalues="20" />
            </_summary>
            <fixed mkbound="0" mk="10" begin="0" count="7800" />
            <moving mkbound="10" mk="20" begin="7800" count="1096" refmotion="0" />
        </particles>
        <constants>
            <data2d value="false" />
            <gravity x="0" y="0" z="-9.81" units_comment="m/s^2" />
            <cflnumber value="0.2" />
            <gamma value="7" />
            <rhop0 value="1000" units_comment="kg/m^3" />
            <dp value="0.02" units_comment="metres (m)" />
            <h value="0.041569219382" units_comment="metres (m)" />
            <b value="0" units_comment="Pascal (Pa)" />
            <massbound value="0.008" units_comment="kg" />
            <massfluid value="0.008" units_comment="kg" />
        </constants>
        <uservars>
            <varnum name="VResId" value="0" />
        </uservars>
        <motion>
            <objreal ref="0">
                <begin mov="1" start="0" />
                <mvnull id="1" />
            </objreal>
        </motion>
        <vtkout mkboundfirst="10" mkfluidfirst="1">
            <vtkfile name="CaseFlapBeach_REG_V1__Dp.vtk" mk="10,20" mkbound="0,10" />
            <vtkfile name="CaseFlapBeach_REG_V1__Actual.vtk" mk="10,20" mkbound="0,10" />
        </vtkout>
    </execution>
</case>
